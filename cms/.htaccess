# cms/ セキュリティ設定
Options -Indexes
DirectoryIndex index.php

# DB ファイルへの直接アクセスを禁止
<FilesMatch "\.(sqlite3|sqlite|db)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# .env.php への直接アクセスを禁止
<FilesMatch "^\.env\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# lib/ と scripts/ への直接アクセスを禁止
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^lib/     - [F,L]
    RewriteRule ^scripts/ - [F,L]
    RewriteRule ^db/      - [F,L]
</IfModule>

# ※ Xserver では php_flag/php_value は .htaccess 不許可のため削除
