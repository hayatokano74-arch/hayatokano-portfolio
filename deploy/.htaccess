# hayatokano.com — Next.js 静的エクスポート用 .htaccess
Options -Indexes
RewriteEngine On

# HTTPS リダイレクト（_cms/ も含む）
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www なし正規化
RewriteCond %{HTTP_HOST} ^www\.hayatokano\.com [NC]
RewriteRule ^(.*)$ https://hayatokano.com/$1 [L,R=301]

# _cms/ はPHPに委譲（Next.jsのrewriteルールを適用しない）
RewriteCond %{REQUEST_URI} ^/_cms/
RewriteRule ^ - [L]

# ── WebP 自動配信 ──
# ブラウザがWebP対応 かつ .webp版が存在する場合、WebPを配信
# 元画像（.jpg/.png）のリクエストに対して .jpg.webp を返す
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME}.webp -f
RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,L]

# WebPのContent-Typeを正しく設定
<IfModule mod_headers.c>
  <FilesMatch "\.webp$">
    Header set Content-Type "image/webp"
    Header append Vary "Accept"
  </FilesMatch>
</IfModule>

# キャッシュ: 画像は1年間キャッシュ
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# ── 動的コンテンツのフォールバック ──
# 静的HTMLが存在しないスラッグ → _fallback/index.html にリライト
# %{REQUEST_FILENAME} ではなく %{REQUEST_URI} ベースでindex.htmlの存在をチェック

# Garden: /garden/SLUG/ で SLUG/index.html が存在しなければフォールバック
RewriteCond %{REQUEST_URI} ^/garden/([^/_][^/]*)/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}index.html !-f
RewriteRule ^ /garden/_fallback/index.html [L]

# Works
RewriteCond %{REQUEST_URI} ^/works/([^/_][^/]*)/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}index.html !-f
RewriteRule ^ /works/_fallback/index.html [L]

# 目の星
RewriteCond %{REQUEST_URI} ^/me-no-hoshi/([^/_][^/]*)/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}index.html !-f
RewriteRule ^ /me-no-hoshi/_fallback/index.html [L]

# Text
RewriteCond %{REQUEST_URI} ^/text/([^/_][^/]*)/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}index.html !-f
RewriteRule ^ /text/_fallback/index.html [L]

# ── trailingSlash 対応 ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.
RewriteRule ^(.+[^/])$ /$1/ [L,R=301]

# ディレクトリのリクエストを index.html に
DirectoryIndex index.html

# 404 エラー
ErrorDocument 404 /404.html
