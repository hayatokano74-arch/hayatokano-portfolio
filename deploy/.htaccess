# hayatokano.com — Next.js 静的エクスポート用 .htaccess
Options -Indexes
RewriteEngine On

# HTTPS リダイレクト（_cms/ も含む）
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www なし正規化
RewriteCond %{HTTP_HOST} ^www\.hayatokano\.com [NC]
RewriteRule ^(.*)$ https://hayatokano.com/$1 [L,R=301]

# _cms/ はPHPに委譲（Next.jsのrewriteルールを適用しない）
RewriteCond %{REQUEST_URI} ^/_cms/
RewriteRule ^ - [L]

# trailingSlash 対応: /about → /about/ → /about/index.html
# Next.js の output: 'export' + trailingSlash: true はディレクトリ構造で生成
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.
RewriteRule ^(.+[^/])$ /$1/ [L,R=301]

# ディレクトリのリクエストを index.html に（_cms/ は index.php が処理）
DirectoryIndex index.html

# Garden フォールバック: 静的HTMLが存在しないスラッグはクライアントサイドで処理
# 既知のスラッグはindex.htmlがあるのでそのまま表示される
# CMS経由で追加された新しいスラッグはHTMLがないのでフォールバック
RewriteCond %{REQUEST_URI} ^/garden/[^/]+/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^garden/[^/]+/?$ /garden/_fallback/index.html [L]

# Works フォールバック（同上）
RewriteCond %{REQUEST_URI} ^/works/[^/]+/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^works/[^/]+/?$ /works/_fallback/index.html [L]

# 目の星 フォールバック（同上）
RewriteCond %{REQUEST_URI} ^/me-no-hoshi/[^/]+/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^me-no-hoshi/[^/]+/?$ /me-no-hoshi/_fallback/index.html [L]

# Text フォールバック（同上）
RewriteCond %{REQUEST_URI} ^/text/[^/]+/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^text/[^/]+/?$ /text/_fallback/index.html [L]

# 404 エラー
ErrorDocument 404 /404.html
